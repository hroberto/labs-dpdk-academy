# Diretórios de build do Meson/Ninja
build/
builddir/
build-*/

# Subprojetos baixados pelo Meson: os arquivos .wrap SÃO versionados
# (fixam versão e hash, garantindo build reprodutível); o código baixado não.
subprojects/*/
subprojects/packagecache/
!subprojects/*.wrap

# Artefatos de compilação
*.o
*.a
*.so
*.out
*.log

# Editores
.vscode/
.idea/
*.swp
*.swo

# Sistema operacional
.DS_Store
Thumbs.db
temp/

# Cache do Python, gerado pelos scripts de verificacao em scripts/
__pycache__/
*.pyc

# Configuracao local do Claude Code: o sufixo `.local` marca o que e pessoal e
# nao deve ser compartilhado. O CLAUDE.md, esse sim, e versionado -- ele carrega
# as instrucoes do projeto, nao as preferencias de uma maquina.
.claude/settings.local.json

# Cache do dmidecode: especifico DESTA maquina, gerado por
# 'sudo ./scripts/ambiente.sh --cachear-memoria'. O que vai ao
# repositorio e a TABELA gerada, nao o cache local.
.ambiente-memoria

# Lixo de redirecionamento errado (`2>1` em vez de `2>&1`). Ja entrou num
# commit uma vez; ignorar e mais barato que lembrar.
/1

# Instrucoes e automacao de agente: ficam locais.
#
# A norma de engenharia que elas aplicam esta em PADROES.md, endereçada a
# qualquer colaborador. O que sai daqui e o enquadramento, nao o criterio.
#
# O workflow de auditoria so executa num produto especifico -- falha no mesmo
# criterio que este projeto aplica a qualquer script: quem clonar precisa
# conseguir rodar.
CLAUDE.md
.claude/
